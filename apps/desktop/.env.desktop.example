# Agent Workflow Platform Desktop - environment variable reference
#
# Copy this file to `.env.desktop` (gitignored) or set the variables in your
# shell. Every value below is an example; the public build performs no hosted
# network access unless you explicitly configure it.

# Hosted account authentication is fail-closed. Only the exact main-process
# value `1` enables it; unset, `0`, `true`, and every other value stay disabled.
# Local demo commands intentionally force the disabled state.
# AWP_HOSTED_AUTH_OPT_IN=1
# Renderer chat/SSE adapter used by the local demo.
VITE_AWP_CHAT_ADAPTER_URL=http://127.0.0.1:8787

# Generic tasks/sessions control plane. This is a different protocol.
AWP_CONTROL_PLANE_URL=http://127.0.0.1:8100

# Optional desktop application update feeds. Stable and Insiders keep
# separate runtime directories; `preview` is only the public build command.
# AWP_UPDATE_URL=https://downloads.example.com/agent-workflow-platform/stable/
# AWP_UPDATE_INSIDERS_URL=https://downloads.example.com/agent-workflow-platform/insiders/

# Agent CLI runtime (disabled by default). Preferred: point at a compatible
# executable already installed by the user. Arguments and child-only
# environment values are optional JSON arrays/objects.
# AWP_AGENT_CLI_EXECUTABLE=C:\Tools\agent-cli.exe
# AWP_AGENT_DEFAULT_MODEL=provider-model-id
# AWP_AGENT_CLI_ARGS_JSON=[]
# AWP_AGENT_CLI_ENV_JSON={}
# AWP_AGENT_CLI_PROTOCOL=awp-jsonl  # awp-jsonl | stream-json

# Checked-in OpenAI-compatible reference adapter. Prefer setting these in the
# launching shell rather than a file. Remote URLs additionally require the
# exact AWP_AGENT_REMOTE_API_OPT_IN=1. Local Ollama-compatible endpoints need
# only AWP_AGENT_MODEL and default to http://127.0.0.1:11434/v1.
# AWP_AGENT_MODEL=llama3.2
# AWP_AGENT_API_BASE_URL=http://127.0.0.1:11434/v1
# AWP_AGENT_API_TOKEN=<read from the operator environment>

# Optional one-tool bridge from the reference adapter to a separately running
# control plane. All three values are required. The local helper
# `python scripts/launch_local_agent_desktop.py --model <id>` captures the
# generated Compose key without printing it and sets these values for you.
# AWP_AGENT_MANAGED_TASKS_OPT_IN=1
# AWP_CONTROL_PLANE_API_KEY=<read from the operator environment>

# Optional managed executable feed. It must be HTTPS and the detached Ed25519
# signature must verify with the configured public key. The signed manifest
# pins the raw executable URL and SHA-256. Leave unset to keep updates disabled.
# AWP_AGENT_RUNTIME_MANIFEST_URL=https://downloads.example.com/agent-runtime/manifest.json
# AWP_AGENT_RUNTIME_PUBLIC_KEY=<base64 Ed25519 SPKI public key>
# AWP_AGENT_RUNTIME_CHANNEL=stable  # stable | insiders

# ---------------------------------------------------------------------------
# Remote workspace tooling (Windows)
# ---------------------------------------------------------------------------

# Absolute directory containing `vmrun.exe`, only when automatic discovery
# does not find the local installation.
# AWP_VMWARE_TOOLS_DIR=C:\Tools\VMware

# Semicolon-separated directories to scan for `.vmx` workspace definitions.
# AWP_VMX_SEARCH_DIRS=D:\VMs;E:\Work\VirtualMachines
# Local traces are disabled unless the value is exactly 1. They stay on this
# device, rotate under the app data directory, and recursively redact common
# credential fields and token-like values. Tool payloads may still be private.
# AWP_ENABLE_LOCAL_TRACE=1

# Optional compatible connection-status SSE adapter. Both values are required.
# Plain HTTP is accepted only for a literal loopback host; remote services must
# use HTTPS. This is never inferred from the chat adapter URL.
# AWP_ENABLE_CONNECTION_HEALTH_SSE=1
# AWP_CONNECTION_HEALTH_SSE_URL=https://status.example.com/v1/status/stream
