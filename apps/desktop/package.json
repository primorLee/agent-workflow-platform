{
  "main": "dist-electron/electron/main.js",
  "name": "agent-workflow-platform-desktop",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "scripts": {
    "dev": "node scripts/demo-dev.mjs",
    "dev:web": "vite",
    "demo:electron": "node scripts/demo-electron.mjs",
    "agent:electron": "node scripts/agent-electron.mjs",
    "openai-compatible:electron": "node scripts/openai-compatible-electron.mjs",
    "dev:electron": "npm run demo:electron",
    "build": "run-s type-check build-only",
    "preview": "vite preview",
    "clean:outputs": "node scripts/clean-output.mjs all",
    "build-only": "node scripts/clean-output.mjs renderer && vite build",
    "type-check": "vue-tsc --build",
    "test": "run-s test:unit test:demo-contract test:demo-electron-launcher test:agent-launcher test:clean-output test:local-package",
    "test:unit": "vitest run --maxWorkers=1",
    "test:demo-contract": "node scripts/demo-contract-smoke.mjs",
    "test:clean-output": "node scripts/clean-output-contract.mjs",
    "test:watch": "vitest",
    "lint": "eslint electron src --ext .ts,.vue",
    "lint:fix": "eslint electron src scripts --ext .ts,.vue --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "e2e": "playwright test",
    "e2e:login": "playwright test --config=playwright.electron.config.ts e2e/login.spec.ts",
    "e2e:login:list": "playwright test --config=playwright.electron.config.ts --list",
    "build:electron-main": "node scripts/clean-output.mjs electron && tsc -p tsconfig.electron.json",
    "build:awp-cloud-mcp": "node scripts/clean-output.mjs cloud-mcp && node scripts/build-awp-cloud-mcp.mjs",
    "verify:no-sourcemaps": "node scripts/assert-no-sourcemaps.mjs",
    "build:desktop-artifacts": "run-s clean:outputs type-check build:electron-main build:awp-cloud-mcp build-only verify:no-sourcemaps",
    "build:electron": "run-s build:desktop-artifacts package:stable",
    "build:electron:dir": "run-s build:desktop-artifacts package:stable:dir",
    "build:electron:preview": "run-s build:desktop-artifacts package:preview",
    "build:electron:insiders": "npm run build:electron:preview",
    "package:stable": "node scripts/local-build-wrapper.js --channel stable",
    "package:stable:dir": "node scripts/local-build-wrapper.js --channel stable -- --dir",
    "package:preview": "node scripts/local-build-wrapper.js --channel preview",
    "verify": "run-s build:desktop-artifacts test",
    "test:local-package": "node scripts/local-package-contract.mjs",
    "demo:electron:check": "node scripts/demo-electron.mjs --build-only",
    "test:demo-electron-launcher": "node scripts/demo-electron-contract.mjs",
    "test:agent-launcher": "node scripts/agent-electron-contract.mjs",
    "test:reference-provider": "vitest run electron/cc/__tests__/cc-wrapper-reference-provider-e2e.spec.ts --maxWorkers=1",
    "demo:electron:ui-smoke": "node scripts/demo-electron-ui-smoke.mjs",
    "demo:electron:smoke": "run-s demo:electron:check demo:electron:ui-smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.0",
    "electron-updater": "^6.8.9",
    "lucide-vue-next": "^1.0.0",
    "marked": "^17.0.5",
    "pinia": "^3.0.4",
    "ssh2": "^1.17.0",
    "tslib": "^2.8.1",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.8",
    "@vue/tsconfig": "^0.9.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.8.9",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "appId": "io.github.primorlee.agentworkflow",
    "productName": "Agent Workflow Platform",
    "directories": {
      "output": "build",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-awp-cloud-mcp/**"
    ],
    "asarUnpack": [
      "dist-electron/electron/services/awp-cloud-mcp/**",
      "dist-awp-cloud-mcp/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Workflow Platform",
      "artifactName": "agent-workflow-platform-${version}.${ext}",
      "differentialPackage": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
