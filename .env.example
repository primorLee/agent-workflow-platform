# Local loopback reference only. Component scripts do not load this file
# automatically. Generate one random key per checkout and keep real values in
# an ignored local environment file or a private absolute key file.

# FastAPI control plane (supported entrypoint: services/control-plane/cloud/server.py)
AWP_ENV=dev
AWP_HOST=127.0.0.1
AWP_PORT=8100
# Leave these unset to use services/control-plane/var, or set BOTH to canonical
# absolute paths whose database is a direct .db child of the private data root.
# AWP_DATA_DIR=/absolute/path/to/control-plane-data
# AWP_DATABASE_URL=/absolute/path/to/control-plane-data/awp.db
AWP_DEV_API_KEY=
# AWP_DEV_API_KEY_FILE=/absolute/private/path/control-plane.key
AWP_WS_BROKER=memory
AWP_REDIS_URL=
AWP_PROMETHEUS_ENABLED=1

# Python worker connecting to the local control plane
AWP_URL=http://127.0.0.1:8100
AWP_API_KEY=
AWP_AGENT_TOKEN=
# Use a canonical absolute path in real deployments.
AWP_WORK_DIR=./.awp-data/worker-agent
# Trusted single-operator demo only; this worker is not an OS sandbox.
AWP_TRUSTED_TASK_EXECUTION_OPT_IN=1

# Browser desktop demo (local Node adapter; no account required)
VITE_AWP_CHAT_ADAPTER_URL=http://127.0.0.1:8787
AWP_DEMO_HOST=127.0.0.1
AWP_DEMO_PORT=8787
AWP_DEMO_DATA_FILE=./.demo-data/sessions.json
AWP_CONTROL_PLANE_URL=http://127.0.0.1:8100
AWP_CONTROL_PLANE_API_KEY=