AWP_ENV=dev
AWP_HOST=127.0.0.1
AWP_PORT=8100
# Defaults to the service-owned var/ directory. If overridden, use canonical
# absolute paths and keep the .db file directly below AWP_DATA_DIR.
# AWP_DATA_DIR=/absolute/path/to/control-plane-data
# AWP_DATABASE_URL=/absolute/path/to/control-plane-data/awp.db
# Configure exactly one explicit random key source.
AWP_DEV_API_KEY=
# AWP_DEV_API_KEY_FILE=/absolute/private/path/control-plane.key
AWP_REDIS_URL=
AWP_WS_BROKER=memory
AWP_SANDBOX_ROOT=
AWP_PROMETHEUS_ENABLED=1