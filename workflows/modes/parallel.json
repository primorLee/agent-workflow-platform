{
  "$schema": "../schemas/mode.schema.json",
  "name": "parallel",
  "label": "High-throughput parallel execution",
  "command": "/parallel",
  "scheduling": {
    "parallel_agents": 8,
    "max_agents_per_batch": 8,
    "batch_strategy": "continuous",
    "auto_continue": true,
    "idle_action": "start_next_batch",
    "min_agents_before_refill": 3,
    "refill_check_interval_sec": 60
  },
  "review": {"internal_review": false, "require_tests": true},
  "reporting": {"checkpoint_interval_min": 30, "batch_summary": true},
  "git": {"commit_style": "batched", "push_after_each_task": false},
  "guardrails": {
    "max_retries_per_error": 2,
    "ask_human_on": ["destructive_git", "overwrite_uncommitted", "external_side_effect"],
    "auto_fix": ["test_failure", "merge_conflict", "missing_import", "lint_error"]
  }
}