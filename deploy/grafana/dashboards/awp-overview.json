{
  "annotations": {"list": []},
  "description": "HTTP metrics emitted by the wired control-plane MetricsMiddleware.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"awp-control-plane\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"awp-control-plane\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "hidden", "placement": "bottom"}},
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{job=\"awp-control-plane\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"awp-control-plane\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (error_kind) (rate(http_requests_total{job=\"awp-control-plane\",error_kind!=\"none\"}[5m]))",
          "legendFormat": "{{error_kind}}",
          "refId": "A"
        }
      ],
      "title": "Unhandled request failures by kind",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["awp", "control-plane", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Agent Workflow Platform HTTP Overview",
  "uid": "awp-overview",
  "version": 2
}
