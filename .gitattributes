* text=auto

# Unix runtimes and configuration must remain LF, even from Windows clones.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf
*.target text eol=lf
*.path text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.env text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Native Windows scripts retain CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary